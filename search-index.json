":[[3,9]]}}}],["пример",{"_index":9,"t":{"13":{"position":[[6,7]]}}}],["упражнен",{"_index":10,"t":{"15":{"position":[[0,10]]}}}],["устро",{"_index":2,"t":{"5":{"position":[[10,8]]}}}],["формализац",{"_index":1,"t":{"3":{"position":[[15,12]]}}}]],"pipeline":["stemmer-ru","stemmer"]}},{"documents":[{"i":1,"t":"Курс и открытая книга по рекомендательным системам — от первых принципов до продвинутых методов и практики.","s":"Рекомендательные системы","u":"/recsys-course/","p":1},{"i":7,"t":"Образцы оформления формул, определений, доказательств, кода и упражнений в хендбуке.","s":"Формат материалов","u":"/recsys-course/about/format/","p":7}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/1",[0,0.651,1,0.651,2,0.651,3,0.651,4,0.651,5,0.651,6,0.651,7,0.651,8,0.651,9,0.651,10,0.651]],["t/7",[11,0.741,12,0.741,13,0.741,14,0.741,15,0.741,16,0.741,17,0.741,18,0.741]]],"invertedIndex":[["",{"_index":5,"t":{"1":{"position":[[51,1]]}}}],["доказательств",{"_index":15,"t":{"7":{"position":[[40,14]]}}}],["книг",{"_index":2,"t":{"1":{"position":[[16,5]]}}}],["код",{"_index":16,"t":{"7":{"position":[[55,4]]}}}],["курс",{"_index":0,"t":{"1":{"position":[[0,4]]}}}],["метод",{"_index":9,"t":{"1":{"position":[[88,7]]}}}],["образц",{"_index":11,"t":{"7":{"position":[[0,7]]}}}],["определен",{"_index":14,"t":{"7":{"position":[[27,12]]}}}],["открыт",{"_index":1,"t":{"1":{"position":[[7,8]]}}}],["оформлен",{"_index":12,"t":{"7":{"position":[[8,10]]}}}],["перв",{"_index":6,"t":{"1":{"position":[[56,6]]}}}],["практик",{"_index":10,"t":{"1":{"position":[[98,9]]}}}],["принцип",{"_index":7,"t":{"1":{"position":[[63,9]]}}}],["продвинут",{"_index":8,"t":{"1":{"position":[[76,11]]}}}],["рекомендательн",{"_index":3,"t":{"1":{"position":[[25,16]]}}}],["систем",{"_index":4,"t":{"1":{"position":[[42,8]]}}}],["упражнен",{"_index":17,"t":{"7":{"position":[[62,10]]}}}],["формул",{"_index":13,"t":{"7":{"position":[[19,7]]}}}],["хендбук",{"_index":18,"t":{"7":{"position":[[75,9]]}}}]],"pipeline":["stemmer-ru","stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer-ru","stemmer"]}},{"documents":[{"i":2,"t":"Курс · Хендбук · Книга От первых принципов до продвинутых методов. С интуицией, математикой и практикой. Рекомендательные системы помогают находить полезное среди множества вариантов: музыку, фильмы, товары, статьи и людей. Эта книга будет последовательно разбирать, как устроены такие системы, почему работают их методы и как применять их на практике.","s":"Рекомендательные системы","u":"/recsys-course/","h":"","p":1},{"i":4,"t":"Начнём с самых основ и постепенно перейдём к сложным моделям и реальным системам. Для каждого метода будем связывать три вещи: задачу, математическую постановку и реализацию. Формулы, выводы и доказательства станут частью объяснения. Важные определения и допущения будем вводить явно, а идеи — подкреплять примерами и упражнениями.","s":"От понимания к формализации","u":"/recsys-course/","h":"#от-понимания-к-формализации","p":1},{"i":6,"t":"Хендбук можно будет читать последовательно или использовать как справочник. Главы появятся в навигации слева; оглавление текущей страницы поможет перемещаться внутри длинных материалов. Сейчас готовится основа книги. Темы, порядок глав и траектории изучения мы определим на следующем этапе. Примеры формул, доказательств и кода собраны на странице «Формат материалов».","s":"Как будет устроена книга","u":"/recsys-course/","h":"#как-будет-устроена-книга","p":1},{"i":8,"t":"Эта страница показывает, как будут выглядеть материалы книги. Она служит образцом оформления; программу курса обсудим отдельно.","s":"Формат материалов","u":"/recsys-course/about/format/","h":"","p":7},{"i":10,"t":"Строчные формулы встраиваются в текст: вектор x∈Rd\\vect{x} \\in \\R^dx∈Rd, матрица R∈Rm×n\\mat{R} \\in \\R^{m \\times n}R∈Rm×n и математическое ожидание E[X]\\E[X]E[X]. Длинные формулы выносятся в отдельный блок. Например, скалярное произведение: ⟨x,y⟩=xTy=∑j=1dxjyj.\\inner{\\vect{x}}{\\vect{y}} = \\vect{x}^{\\mathsf T}\\vect{y} = \\sum_{j=1}^{d} x_j y_j.⟨x,y⟩=xTy=j=1∑d​xj​yj​. Поддерживаются многострочные выводы и матрицы: ∥x−y∥2=⟨x−y,x−y⟩=∥x∥2−2⟨x,y⟩+∥y∥2,A=(1001).\\begin{aligned} \\norm{\\vect{x}-\\vect{y}}^2 &= \\inner{\\vect{x}-\\vect{y}}{\\vect{x}-\\vect{y}} \\\\ &= \\norm{\\vect{x}}^2 - 2\\inner{\\vect{x}}{\\vect{y}} + \\norm{\\vect{y}}^2, \\end{aligned} \\qquad \\mat{A}=\\begin{pmatrix}1 & 0 \\\\ 0 & 1\\end{pmatrix}.∥x−y∥2​=⟨x−y,x−y⟩=∥x∥2−2⟨x,y⟩+∥y∥2,​A=(10​01​).","s":"Математические обозначения","u":"/recsys-course/about/format/","h":"#математические-обозначения","p":7},{"i":12,"t":"Определение · Евклидова норма# Для вектора x∈Rd\\vect{x} \\in \\R^dx∈Rd евклидова норма задаётся формулой ∥x∥2=∑j=1dxj2.\\norm{\\vect{x}}_2 = \\sqrt{\\sum_{j=1}^{d} x_j^2}.∥x∥2​=j=1∑d​xj2​​. Теорема · Неотрицательность нормы# Для любого x∈Rd\\vect{x} \\in \\R^dx∈Rd выполняется ∥x∥2≥0\\norm{\\vect{x}}_2 \\ge 0∥x∥2​≥0. Равенство достигается тогда и только тогда, когда x=0\\vect{x}=\\vect{0}x=0. Доказательство Каждое слагаемое xj2x_j^2xj2​ неотрицательно. Их сумма и её квадратный корень также неотрицательны. Сумма равна нулю тогда и только тогда, когда все координаты xjx_jxj​ равны нулю. □ У определения и теоремы есть постоянные ссылки: например, определение нормы. Доказательство можно раскрыть при чтении.","s":"Определения и доказательства","u":"/recsys-course/about/format/","h":"#определения-и-доказательства","p":7},{"i":14,"t":"Пример на чистом Python from math import sqrt def euclidean_norm(vector: list[float]) -> float: return sqrt(sum(value * value for value in vector)) print(euclidean_norm([3.0, 4.0])) # 5.0 Как читать примеры В главах будем пояснять входные данные, предположения и смысл результата. Большие эксперименты можно будет вынести в отдельные ноутбуки.","s":"Код и примеры","u":"/recsys-course/about/format/","h":"#код-и-примеры","p":7},{"i":16,"t":"Упражнение · Норма вектора# Вычислите ∥(1,2,2)∥2\\norm{(1,2,2)}_2∥(1,2,2)∥2​ вручную и проверьте ответ с помощью кода выше. Проверить ответ 12+22+22=3.\\sqrt{1^2+2^2+2^2}=3.12+22+22​=3.","s":"Упражнения","u":"/recsys-course/about/format/","h":"#упражнения","p":7},{"i":18,"t":"Каждую содержательную главу будут сопровождать ссылки на первоисточники и дополнительные материалы. Формат библиографии и общую систему обозначений согласуем вместе с планом книги.","s":"Источники","u":"/recsys-course/about/format/","h":"#источники","p":7}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/2",[0,1.364,1,0.586,2,1.364,3,1.085,4,1.866,5,1.866,6,1.866,7,1.885,8,1.866,9,1.866,10,2.579,11,1.866,12,1.885,13,1.866,14,1.866,15,1.866,16,1.866,17,1.866,18,1.866,19,1.866,20,1.866,21,1.866,22,1.866,23,1.866,24,1.364,25,1.866,26,1.866,27,1.866,28,1.866]],["t/4",[1,0.429,7,1.381,12,1.381,29,1.889,30,1.889,31,1.889,32,1.889,33,1.889,34,1.889,35,1.889,36,1.889,37,1.381,38,1.889,39,1.889,40,1.889,41,1.381,42,1.889,43,1.889,44,0.795,45,1.381,46,1.045,47,1.889,48,1.889,49,1.889,50,1.381,51,1.889,52,1.889,53,1.889,54,1.889,55,1.889,56,1.889,57,1.045,58,1.381]],["t/6",[2,1.331,3,0.767,24,1.331,44,0.767,46,1.008,57,1.008,59,1.331,60,1.821,61,1.821,62,1.403,63,1.821,64,1.821,65,1.821,66,1.821,67,1.821,68,1.853,69,1.821,70,1.821,71,1.821,72,1.331,73,1.403,74,1.821,75,1.821,76,1.821,77,1.821,78,1.821,79,1.821,80,1.821,81,1.821,82,1.821,83,1.331,84,1.821,85,1.331]],["t/8",[0,1.87,3,1.077,68,1.87,73,1.416,86,2.56,87,2.56,88,2.56,89,2.56,90,2.56,91,2.56,92,2.56,93,1.416]],["t/10",[1,0.785,41,1.063,44,0.908,45,1.063,72,1.063,93,0.805,94,1.454,95,1.454,96,1.454,97,0.805,98,1.063,99,1.063,100,2.157,101,1.454,102,1.454,103,1.454,104,1.454,105,1.454,106,1.454,107,1.454,108,1.454,109,1.063,110,1.454,111,1.454,112,1.454,113,1.454,114,1.454,115,1.454,116,1.454,117,1.454,118,1.454,119,1.454,120,1.454,121,1.454,122,1.454,123,1.454,124,1.454,125,1.454,126,1.454,127,1.454,128,1.454,129,1.454,130,1.454,131,1.454,132,2.157,133,1.454]],["t/12",[1,0.652,44,0.624,46,1.2